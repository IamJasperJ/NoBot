{
  "name": "nobot",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@nobot/server' --filter '@nobot/web' dev",
    "build": "bun run --filter '@nobot/web' build",
    "start": "bun run --filter '@nobot/server' start",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "bun run --filter '@nobot/server' db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
